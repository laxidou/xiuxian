http://localhost, https://localhost {
    encode zstd gzip

    handle /healthz {
        reverse_proxy game-server:8080 {
            flush_interval -1
        }
    }

    handle /events/stream {
        reverse_proxy game-server:8080 {
            flush_interval -1
        }
    }

    handle /api/v1/* {
        respond 404
    }

    handle /internal/* {
        reverse_proxy game-server:8080
    }

    handle /test/clock/advance {
        reverse_proxy game-server:8080
    }

    @game_api path /game-rules /state /world/bounds /scans /movements /directional-movements /movement-stops /cultivation-transfers /cultivation-seizures /reincarnations /events /conversations /conversation-responses /conversation-messages /conversation-closures /registrations /sessions /session /mcp-key-rotations /mcp-key
    handle @game_api {
        reverse_proxy game-server:8080
    }

    handle /mcp {
        reverse_proxy mcp-gateway:8090
    }

    handle {
        reverse_proxy web:80
    }
}
